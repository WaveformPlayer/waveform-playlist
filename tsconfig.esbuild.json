// The only tsconfig esbuild reads (every build script passes --tsconfig).
// Kept apart from tsconfig.json on purpose: esbuild turns that file's
// `strict: true` into a "use strict" directive at the top of the IIFE builds,
// which 1.x never had, and TypeScript 7 no longer accepts `alwaysStrict: false`.
// useDefineForClassFields stays true so statics are never lowered to
// `static {}` blocks (Safari 16.4+).
{
  "compilerOptions": {
    "useDefineForClassFields": true,
    "verbatimModuleSyntax": true
  }
}
